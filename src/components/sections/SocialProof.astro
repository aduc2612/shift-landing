---
import { socialProof } from "$lib/constants";
import { Card, CardContent } from "$lib/components/ui/card";
---

<section id="social-proof" class="w-full py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
        {socialProof.heading}
      </h2>
      <p class="mt-6 text-5xl md:text-6xl font-bold text-muted-foreground">
        {socialProof.counter.toLocaleString()}
      </p>
      <p class="mt-2 text-lg text-muted-foreground">people on the waitlist</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {socialProof.testimonials.map((t) => (
        <Card>
          <CardContent class="pt-6">
            <blockquote class="text-lg leading-relaxed">
              "{t.quote}"
            </blockquote>
            <p class="mt-4 text-sm text-muted-foreground">— {t.persona}</p>
          </CardContent>
        </Card>
      ))}
    </div>
  </div>
</section>
