---
import { features } from "$lib/constants";
import {
  RefreshCw,
  Sparkles,
  Bell,
  MessageCircleQuestionMark,
  Undo2,
  SlidersHorizontal,
} from "@lucide/svelte";

const iconMap: Record<string, any> = {
  "refresh-cw": RefreshCw,
  sparkles: Sparkles,
  bell: Bell,
  "message-circle-question-mark": MessageCircleQuestionMark,
  "undo-2": Undo2,
  "sliders-horizontal": SlidersHorizontal,
};
---

<section id="features" class="w-full py-16 md:py-24 bg-surface-dark">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
        {features.heading}
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">
        {features.subheading}
      </p>
    </div>

    <div class="space-y-16 md:space-y-24">
      {features.items.map((item, index) => {
        const Icon = iconMap[item.icon];
        const isEven = index % 2 === 0;
        return (
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
            {isEven ? (
              <>
                <div>
                  <div class="text-muted-foreground mb-3">
                    {Icon && <Icon class="size-6" />}
                  </div>
                  <h3 class="text-2xl font-bold mb-3">{item.title}</h3>
                  <p class="text-muted-foreground text-lg">{item.description}</p>
                </div>
                <div class="mx-auto w-full max-w-[260px] aspect-[9/16] rounded-2xl bg-muted/30 border border-border/30 flex items-center justify-center">
                  <span class="text-xs text-muted-foreground/50">App screenshot</span>
                </div>
              </>
            ) : (
              <>
                <div class="order-2 lg:order-1 mx-auto w-full max-w-[260px] aspect-[9/16] rounded-2xl bg-muted/30 border border-border/30 flex items-center justify-center">
                  <span class="text-xs text-muted-foreground/50">App screenshot</span>
                </div>
                <div class="order-1 lg:order-2">
                  <div class="text-muted-foreground mb-3">
                    {Icon && <Icon class="size-6" />}
                  </div>
                  <h3 class="text-2xl font-bold mb-3">{item.title}</h3>
                  <p class="text-muted-foreground text-lg">{item.description}</p>
                </div>
              </>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>
