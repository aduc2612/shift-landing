---
import { hero } from "$lib/constants";
import EmailForm from "../EmailForm.svelte";
---

<section id="hero" class="w-full py-24 md:py-32 lg:py-40">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:grid lg:grid-cols-[1.5fr_1fr] lg:gap-12 lg:items-center">
    <div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-tight" set:html={hero.headline} />
      <p class="mt-6 text-lg md:text-xl text-muted-foreground max-w-2xl">
        {hero.subheadline}
      </p>
      <div class="mt-10">
        <EmailForm
          client:load
          placeholderText={hero.placeholderText}
          buttonText={hero.ctaText}
        />
      </div>
    </div>

    <!-- Placeholder app screenshot -->
    <div
      class="mt-16 lg:mt-0 mx-auto w-full max-w-[280px] aspect-[9/16] rounded-2xl bg-muted/30 border border-border/30 flex items-center justify-center"
      aria-hidden="true"
    >
      <span class="text-sm text-muted-foreground/50">App screenshot</span>
    </div>
  </div>
</section>
