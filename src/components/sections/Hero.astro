---
import { hero } from "$lib/constants";
import EmailForm from "../EmailForm.svelte";
---

<section id="hero" class="w-full py-24 md:py-32 lg:py-40">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="max-w-3xl">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-tight" set:html={hero.headline} />
      <p class="mt-6 text-lg md:text-xl text-muted-foreground max-w-2xl">
        {hero.subheadline}
      </p>
      <div class="mt-10">
        <EmailForm
          client:load
          placeholderText={hero.placeholderText}
          buttonText={hero.ctaText}
        />
      </div>
    </div>

    <!-- Placeholder image area -->
    <div
      class="mt-16 w-full aspect-[16/9] rounded-xl bg-gradient-to-br from-muted/50 to-muted/20 border border-border/50"
      aria-hidden="true"
    >
    </div>
  </div>
</section>
